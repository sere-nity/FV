# Copy to .env.local and fill in. Never commit .env.local.

# From the Create app dialog at https://fanvue.com/developers/apps (the secret is shown once)
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Space separated. Must match the scopes ticked on the app's Authentication tab.
# Later: "read:self read:chat write:chat read:fan"
OAUTH_SCOPES=read:self

# Must exactly match a redirect URI on the Authentication tab.
# portless alternative: https://fanvue-curator.localhost/api/oauth/callback
OAUTH_REDIRECT_URI=https://fanvue-curator.dev:3001/api/oauth/callback

# Public origin the app is served from (used for post-login redirects).
# portless alternative: https://fanvue-curator.localhost
BASE_URL=https://fanvue-curator.dev:3001

# At least 32 characters: openssl rand -hex 32
SESSION_SECRET=
SESSION_COOKIE_NAME=fanvue_oauth

OAUTH_ISSUER_BASE_URL=https://auth.fanvue.com
API_BASE_URL=https://api.fanvue.com
