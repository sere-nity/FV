# Copy to .env.local and fill in. Never commit .env.local.
# Read by the Builder SDK's createConfig() on the server only.

# From the Create app dialog at https://fanvue.com/developers/apps (the secret is shown once)
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Must equal the FIRST redirect URI registered on the app. No browser visits it,
# but the session-token exchange fails if the two differ.
# portless alternative: https://fanvue-curator.localhost/api/oauth/callback
OAUTH_REDIRECT_URI=https://fanvue-curator.dev:3001/api/oauth/callback

# Signs the session JWT the creator surface holds. At least 32 characters: openssl rand -hex 32
SESSION_SECRET=

# Production defaults. Dev Fanvue: https://dev.fanvue.com, https://auth.dev.fanvue.com, https://api.dev.fanvue.com
FANVUE_PLATFORM_URL=https://www.fanvue.com
OAUTH_ISSUER_BASE_URL=https://auth.fanvue.com
API_BASE_URL=https://api.fanvue.com

# SQLite database file
DATABASE_URL="file:./dev.db"

# xAI API key for Grok (https://console.x.ai/)
XAI_API_KEY=

# Data source: mock or fanvue (default: mock)
DATA_SOURCE=mock
