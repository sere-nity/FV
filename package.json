{
  "name": "fanvue-curator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "proxy": "pnpm dlx local-ssl-proxy --source 3001 --target 3000 --cert ./fanvue-curator.dev.pem --key ./fanvue-curator.dev-key.pem",
